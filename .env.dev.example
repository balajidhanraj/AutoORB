# ==============================================================================
# AutoORB Development / Staging Environment (.env.dev) — PAPER SIMULATION ONLY
# Copy to /opt/autoorb/.env.dev on your VPS (or auto-generated by setup_vps_multi_env.sh)
# NEVER commit .env.dev to Git.
# ==============================================================================

APP_ENV=development
MODE=PAPER
UI_HOST=0.0.0.0
UI_PORT=8000
HEADLESS_BROWSER=true
TZ=Asia/Kolkata

# Isolated Dev PostgreSQL Database (inside docker-compose.vps.yml network)
DATABASE_URL=postgresql+asyncpg://autoorb:CHANGE_ME_STRONG_PG_PASS@postgres:5432/autoorb_dev

# Permissive CORS for dev / mobile testing / localhost
CORS_ORIGINS=*

# Separate Dev Security Secrets (NEVER share keys with production)
JWT_SECRET=CHANGE_ME_GENERATE_64_HEX_CHAR_DEV_JWT_SECRET
APP_ENCRYPTION_KEY=CHANGE_ME_GENERATE_64_HEX_CHAR_DEV_AES_KEY
UI_PIN=12345

# Shoonya Credentials (optional in dev; leave blank or use read-only/paper token)
SHOONYA_USER_ID=
SHOONYA_ACCOUNT_ID=
SHOONYA_PASSWORD=
SHOONYA_TOTP_SECRET=
SHOONYA_API_KEY=
SHOONYA_SECRET_KEY=
SHOONYA_REDIRECT_URI=https://dev.yourdomain.com/callback
SEBI_ALGO_ID=ORB_VWAP_RSI_2026_DEV

# Paper Trading Capital & Risk Limits
CAPITAL=100000
MAX_DAILY_LOSS=3000
MAX_TRADES_PER_DAY=4
MIN_INDIA_VIX=12.0
MIN_ORB_RANGE_PCT=0.20
MAX_ORB_RANGE_PCT=0.85
DAILY_BIAS_FILTER=true
USE_EMA_FILTER=true
MIN_CANDLE_BODY_RATIO=0.40
TUESDAY_EXPIRY_BOOST=true
MAX_WEEKLY_LOSSES=3

# Optional Dev Telegram Channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional OAuth Providers
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FIREBASE_WEB_API_KEY=
