# ==============================================================================
# Shared Docker Compose VPS Stack Environment (/opt/autoorb/.env.vps)
# Passed via: docker compose -f docker-compose.vps.yml --env-file /opt/autoorb/.env.vps up -d
# ==============================================================================

# Public subdomains pointing DNS A-records to your VPS Static IP
PROD_DOMAIN=app.yourdomain.com
DEV_DOMAIN=dev.yourdomain.com
ACME_EMAIL=admin@yourdomain.com

# Shared Postgres cluster superuser (Prod uses autoorb_prod, Dev uses autoorb_dev)
POSTGRES_USER=autoorb
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PG_PASS

# VPS folder paths (standard /opt/autoorb layout)
PROD_BUILD_CONTEXT=/opt/autoorb/prod
DEV_BUILD_CONTEXT=/opt/autoorb/dev
PROD_ENV_FILE=/opt/autoorb/.env.prod
DEV_ENV_FILE=/opt/autoorb/.env.dev
DATA_ROOT=/opt/autoorb/volumes
