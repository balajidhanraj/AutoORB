[Unit]
Description=Shoonya Automated ORB Options Trading System + Web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/autoorb
Environment="TZ=Asia/Kolkata"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/home/ubuntu/autoorb/.venv/bin/python /home/ubuntu/autoorb/main.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
