# ==============================================================================
# AutoORB Production Environment (.env.prod) — REAL LIVE TRADING
# Copy to /opt/autoorb/.env.prod on your VPS (or auto-generated by setup_vps_multi_env.sh)
# NEVER commit .env.prod to Git.
# ==============================================================================

APP_ENV=production
MODE=LIVE
UI_HOST=0.0.0.0
UI_PORT=8000
HEADLESS_BROWSER=true
TZ=Asia/Kolkata

# Isolated Production PostgreSQL Database (inside docker-compose.vps.yml network)
DATABASE_URL=postgresql+asyncpg://autoorb:CHANGE_ME_STRONG_PG_PASS@postgres:5432/autoorb_prod

# Allowed Web & Mobile Capacitor Origins (replace with your real production domain)
CORS_ORIGINS=https://app.yourdomain.com,http://localhost,https://localhost,capacitor://localhost

# Security Secrets (MUST BE UNIQUE STRONG RANDOM 64-CHAR STRINGS IN PRODUCTION)
JWT_SECRET=CHANGE_ME_GENERATE_64_HEX_CHAR_PRODUCTION_JWT_SECRET
APP_ENCRYPTION_KEY=CHANGE_ME_GENERATE_64_HEX_CHAR_PRODUCTION_AES_KEY
UI_PIN=CHANGE_ME_STRONG_PIN

# Finvasia Shoonya Broker Credentials (Live Account)
SHOONYA_USER_ID=
SHOONYA_ACCOUNT_ID=
SHOONYA_PASSWORD=
SHOONYA_TOTP_SECRET=
SHOONYA_API_KEY=
SHOONYA_SECRET_KEY=
SHOONYA_REDIRECT_URI=https://app.yourdomain.com/callback
SEBI_ALGO_ID=ORB_VWAP_RSI_2026

# Production Risk & Strategy Controls
CAPITAL=200000
MAX_DAILY_LOSS=5000
MAX_TRADES_PER_DAY=2
MIN_INDIA_VIX=12.0
MIN_ORB_RANGE_PCT=0.20
MAX_ORB_RANGE_PCT=0.85
DAILY_BIAS_FILTER=true
USE_EMA_FILTER=true
MIN_CANDLE_BODY_RATIO=0.40
TUESDAY_EXPIRY_BOOST=true
MAX_WEEKLY_LOSSES=2

# Telegram Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional OAuth Providers (configure redirect URI to https://app.yourdomain.com)
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FIREBASE_WEB_API_KEY=
