# Shoonya Automated Options Trading System (ORB + VWAP + RSI)
MODE=PAPER                       # PAPER or LIVE
SHOONYA_HOST=https://api.shoonya.com/NorenWClientAPI/
SHOONYA_WS_HOST=wss://api.shoonya.com/NorenWSAPI/
SHOONYA_USER_ID=
SHOONYA_ACCOUNT_ID=
SHOONYA_PASSWORD=
SHOONYA_TOTP_SECRET=             # Base32 TOTP secret key from Shoonya 2FA setup
SHOONYA_API_KEY=
SHOONYA_SECRET_KEY=
SHOONYA_REDIRECT_URI=http://127.0.0.1:8080/callback
SHOONYA_ACCESS_TOKEN=            # Auto-populated daily at 08:40 AM IST
TOKEN_FILE_PATH=data/daily_token.json
SEBI_ALGO_ID=                    # Exchange-registered Algo ID from Shoonya compliance

HEADLESS_BROWSER=true            # true for Linux VPS, false for local debugging
CAPITAL=200000
MAX_DAILY_LOSS=5000
MAX_TRADES_PER_DAY=2

# Volatility & Range Filters
MIN_INDIA_VIX=12.0
MAX_ORB_RANGE_PCT=0.75

# Telegram Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Web Dashboard UI
UI_HOST=0.0.0.0
UI_PORT=8000
UI_PIN=1234
